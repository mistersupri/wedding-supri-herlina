// One database per wedding. The invitation and photo-frame settings are single rows (id "main").

generator client {
  provider = "prisma-client"
  output   = "../server/infrastructure/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AttendanceStatus {
  HADIR
  TIDAK_HADIR
  RAGU
}

enum GalleryCategory {
  PREWEDDING
  ENGAGEMENT
  MOMENTS
  CEREMONY
}

enum MediaType {
  IMAGE
  VIDEO
}

enum CheckInMethod {
  QR_SCAN
  MANUAL
  /// The guest confirmed it on their own phone.
  SELF
}

enum AdminRole {
  SUPERADMIN
  ADMIN
}

model Invitation {
  id               String    @id @default("main")
  groomName        String
  groomShortName   String
  groomParents     String
  groomInstagram   String?
  groomPhoto       String
  brideName        String
  brideShortName   String
  brideParents     String
  brideInstagram   String?
  bridePhoto       String
  heroImage        String
  heroVideoUrl     String?
  heroMediaType    MediaType @default(IMAGE)
  /// Photos and videos for the opening screen of templates that play a sequence: [{ type, url, poster? }].
  heroSlides       Json      @default("[]")
  /// The couple's own wording for texts a template would otherwise write itself: { greetingTitle?, greetingBody?, closing?, letter?, credits?, receiptNote? }.
  texts            Json      @default("{}")
  quoteText        String
  quoteSource      String
  weddingDate      DateTime
  countdownTarget  DateTime
  musicUrl         String
  musicTitle       String
  whatsappNumber   String
  whatsappTemplate String
  templateId       String    @default("nusantara")
  themeColor       String    @default("sogan")
  updatedAt        DateTime  @updatedAt
}

model Event {
  id           String  @id @default(cuid())
  title        String
  date         String
  startTime    String
  endTime      String
  venueName    String
  address      String
  mapsUrl      String
  mapsEmbedUrl String?
  dressCode    String?
  notes        String?
  orderIndex   Int     @default(0)
}

model LoveStory {
  id          String  @id @default(cuid())
  year        String
  title       String
  description String
  photoUrl    String?
  orderIndex  Int     @default(0)
}

model GiftAccount {
  id            String  @id @default(cuid())
  bankName      String
  accountNumber String
  accountHolder String
  isQris        Boolean @default(false)
  qrisImageUrl  String?
  orderIndex    Int     @default(0)
}

model GalleryPhoto {
  id           String          @id @default(cuid())
  title        String
  url          String
  caption      String?
  category     GalleryCategory @default(MOMENTS)
  mediaType    MediaType       @default(IMAGE)
  thumbnailUrl String?
  orderIndex   Int             @default(0)
}

model GuestWish {
  id               String           @id @default(cuid())
  guestName        String
  /// One wish per key: "code:<invitation code>" for invited guests; older anonymous wishes keep the lower-cased name.
  guestKey         String           @unique
  /// Invitation code of the sender. Never sent to the public page.
  guestSlug        String?
  relationship     String
  attendanceStatus AttendanceStatus
  numberOfGuests   Int              @default(1)
  message          String
  voiceUrl         String?
  reply            String?
  isHidden         Boolean          @default(false)
  createdAt        DateTime         @default(now())

  @@index([createdAt])
  @@index([guestSlug])
}

model InvitedGuest {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  phone            String         @default("")
  instagram        String         @default("")
  category         String         @default("Umum")
  pax              Int            @default(2)
  tableNumber      String         @default("")
  customNote       String         @default("")
  invitationSent   Boolean        @default(false)
  invitationSentAt DateTime?
  /// When the guest first opened the cover of their personal invitation, and most recently. Null until then.
  firstOpenedAt    DateTime?
  lastOpenedAt     DateTime?
  /// Distinct visits that opened the cover (reopening within a minute counts once).
  openCount        Int            @default(0)
  /// Last WhatsApp reminder the couple sent this guest, and how many so far.
  lastRemindedAt   DateTime?
  reminderCount    Int            @default(0)
  isCheckedIn      Boolean        @default(false)
  checkInTime      DateTime?
  checkInMethod    CheckInMethod?
  actualPax        Int?
  souvenirGiven    Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model PhotoMoment {
  id            String         @id @default(cuid())
  guestName     String
  guestSlug     String?
  /// Feed-sized copy (about 1080 px wide).
  photoUrl      String
  /// Full-resolution copy for download. Older photos only have photoUrl.
  originalUrl   String?
  caption       String         @default("")
  /// Frames of the guest's quota this picture used: 1, or 2 to 4 for a photo-strip or grid collage.
  frames        Int            @default(1)
  /// Film look the guest used, for the CMS ("none" when unedited).
  look          String?
  /// False while the couple has not reviewed it (moderation on).
  approved      Boolean        @default(true)
  likesCount    Int            @default(0)
  /// Emoji -> count.
  reactions     Json           @default("{}")
  commentsCount Int            @default(0)
  createdAt     DateTime       @default(now())
  comments      PhotoComment[]

  @@index([guestSlug])
  @@index([createdAt])
  @@index([approved, createdAt])
}

model PhotoComment {
  id        String      @id @default(cuid())
  momentId  String
  moment    PhotoMoment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  guestName String
  guestSlug String?
  text      String
  createdAt DateTime    @default(now())

  @@index([momentId, createdAt])
}

enum MomentAccess {
  /// Invited guests whose arrival was recorded at reception.
  CHECKED_IN
  /// Any guest with a valid invitation code.
  INVITED
  /// Anyone who types a name (for a table QR without codes).
  ANYONE
}

enum MomentVisibility {
  ALL
  OWN
}

enum MomentDownload {
  NONE
  OWN
  ALL
}

/// The couple's rules for the guest camera.
model CameraSetting {
  id             String           @id @default("main")
  /// CHECKED_IN is the old "invited and checked in" mode: it is rewritten to INVITED + requireCheckIn and never written again.
  access         MomentAccess     @default(INVITED)
  /// Invited guests must be checked in before they can use the camera.
  requireCheckIn Boolean          @default(false)
  framesPerGuest Int              @default(15)
  cameraOpen     Boolean          @default(true)
  moderation     Boolean          @default(false)
  visibility     MomentVisibility @default(ALL)
  download       MomentDownload   @default(OWN)
  /// Film look ids guests may use; empty means all of them.
  enabledLooks   String[]         @default([])
  defaultLook    String           @default("none")
  screenEnabled  Boolean          @default(true)
}

/// Self check-in by guests. A single row (id "main").
model AttendanceSetting {
  id             String  @id @default("main")
  /// Guests may mark themselves present from the invitation.
  selfCheckIn    Boolean @default(false)
  /// Require the phone to be within radiusMeters of the venue.
  verifyLocation Boolean @default(true)
  venueLat       Float?
  venueLng       Float?
  radiusMeters   Int     @default(150)
}

model PhotoFrameSetting {
  id               String  @id @default("main")
  enabled          Boolean @default(true)
  frameOverlayUrl  String
  frameName        String?
  allowGuestToggle Boolean @default(true)
  /// True: the guest's photo is placed in front of the frame, inside the margins below (for frames that are a solid picture).
  /// False: the frame is drawn over the photo and must be a transparent PNG.
  photoInFront     Boolean @default(false)
  /// Margins of the photo area, in percent of the frame's width (left, right) and height (top, bottom).
  photoInsetTop    Int     @default(8)
  photoInsetRight  Int     @default(8)
  photoInsetBottom Int     @default(24)
  photoInsetLeft   Int     @default(8)
  /// Behind-the-frame mode only: place the photo inside the margins above instead of letting it fill the picture.
  photoManualArea  Boolean @default(false)
  /// Border around each photo, and the gap between photos of a collage, in pixels on a 1080 px wide picture.
  photoBorder      Int     @default(0)
  photoBorderColor String  @default("#FFFFFF")
  photoGap         Int     @default(38)
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())
}
