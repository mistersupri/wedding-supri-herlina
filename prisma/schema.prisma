datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Invitation {
  id               String   @id @default(cuid())
  groomName        String
  groomShortName   String
  groomParents     String
  groomInstagram   String?
  groomPhoto       String
  brideName        String
  brideShortName   String
  brideParents     String
  brideInstagram   String?
  bridePhoto       String
  weddingDate      DateTime
  countdownTarget  DateTime
  heroImage        String
  quoteText        String
  quoteSource      String
  musicUrl         String
  musicTitle       String
  whatsappNumber   String
  whatsappTemplate String
  themeColor       String   @default("rose")
  giftInfo         String
  loveStories      String
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}

model Event {
  id           String   @id @default(cuid())
  title        String
  date         String
  startTime    String
  endTime      String
  venueName    String
  address      String
  mapsUrl      String
  mapsEmbedUrl String?
  dressCode    String?
  notes        String?
  orderIndex   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Guest {
  id               String   @id @default(cuid())
  guestName        String
  relationship     String
  attendanceStatus String
  numberOfGuests   Int      @default(1)
  message          String
  reply            String?
  isHidden         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model GalleryImage {
  id         String   @id @default(cuid())
  title      String
  url        String
  caption    String?
  category   String   @default("MOMENTS")
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
