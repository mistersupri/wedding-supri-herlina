// One database per wedding. The invitation and photo-frame settings are single rows (id "main").

generator client {
  provider = "prisma-client"
  output   = "../server/infrastructure/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AttendanceStatus {
  HADIR
  TIDAK_HADIR
  RAGU
}

enum GalleryCategory {
  PREWEDDING
  ENGAGEMENT
  MOMENTS
  CEREMONY
}

enum MediaType {
  IMAGE
  VIDEO
}

enum CheckInMethod {
  QR_SCAN
  MANUAL
}

enum AdminRole {
  SUPERADMIN
  ADMIN
}

model Invitation {
  id               String    @id @default("main")
  groomName        String
  groomShortName   String
  groomParents     String
  groomInstagram   String?
  groomPhoto       String
  brideName        String
  brideShortName   String
  brideParents     String
  brideInstagram   String?
  bridePhoto       String
  heroImage        String
  heroVideoUrl     String?
  heroMediaType    MediaType @default(IMAGE)
  quoteText        String
  quoteSource      String
  weddingDate      DateTime
  countdownTarget  DateTime
  musicUrl         String
  musicTitle       String
  whatsappNumber   String
  whatsappTemplate String
  templateId       String    @default("nusantara")
  themeColor       String    @default("sogan")
  updatedAt        DateTime  @updatedAt
}

model Event {
  id           String  @id @default(cuid())
  title        String
  date         String
  startTime    String
  endTime      String
  venueName    String
  address      String
  mapsUrl      String
  mapsEmbedUrl String?
  dressCode    String?
  notes        String?
  orderIndex   Int     @default(0)
}

model LoveStory {
  id          String  @id @default(cuid())
  year        String
  title       String
  description String
  photoUrl    String?
  orderIndex  Int     @default(0)
}

model GiftAccount {
  id            String  @id @default(cuid())
  bankName      String
  accountNumber String
  accountHolder String
  isQris        Boolean @default(false)
  qrisImageUrl  String?
  orderIndex    Int     @default(0)
}

model GalleryPhoto {
  id           String          @id @default(cuid())
  title        String
  url          String
  caption      String?
  category     GalleryCategory @default(MOMENTS)
  mediaType    MediaType       @default(IMAGE)
  thumbnailUrl String?
  orderIndex   Int             @default(0)
}

model GuestWish {
  id               String           @id @default(cuid())
  guestName        String
  /// Lower-cased, trimmed name: one wish per guest name.
  guestKey         String           @unique
  relationship     String
  attendanceStatus AttendanceStatus
  numberOfGuests   Int              @default(1)
  message          String
  voiceUrl         String?
  reply            String?
  isHidden         Boolean          @default(false)
  createdAt        DateTime         @default(now())

  @@index([createdAt])
}

model InvitedGuest {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  phone            String         @default("")
  instagram        String         @default("")
  category         String         @default("Umum")
  pax              Int            @default(2)
  tableNumber      String         @default("")
  customNote       String         @default("")
  invitationSent   Boolean        @default(false)
  invitationSentAt DateTime?
  isCheckedIn      Boolean        @default(false)
  checkInTime      DateTime?
  checkInMethod    CheckInMethod?
  actualPax        Int?
  souvenirGiven    Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model PhotoMoment {
  id            String         @id @default(cuid())
  guestName     String
  guestSlug     String?
  /// Feed-sized copy (about 1080 px wide).
  photoUrl      String
  /// Full-resolution copy for download. Older photos only have photoUrl.
  originalUrl   String?
  caption       String         @default("")
  /// Film look the guest used, for the CMS ("none" when unedited).
  look          String?
  /// False while the couple has not reviewed it (moderation on).
  approved      Boolean        @default(true)
  likesCount    Int            @default(0)
  /// Emoji -> count.
  reactions     Json           @default("{}")
  commentsCount Int            @default(0)
  createdAt     DateTime       @default(now())
  comments      PhotoComment[]

  @@index([guestSlug])
  @@index([createdAt])
  @@index([approved, createdAt])
}

model PhotoComment {
  id        String      @id @default(cuid())
  momentId  String
  moment    PhotoMoment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  guestName String
  guestSlug String?
  text      String
  createdAt DateTime    @default(now())

  @@index([momentId, createdAt])
}

enum MomentAccess {
  /// Invited guests whose arrival was recorded at reception.
  CHECKED_IN
  /// Any guest with a valid invitation code.
  INVITED
  /// Anyone who types a name (for a table QR without codes).
  ANYONE
}

enum MomentVisibility {
  ALL
  OWN
}

enum MomentDownload {
  NONE
  OWN
  ALL
}

/// The couple's rules for the guest camera.
model CameraSetting {
  id             String           @id @default("main")
  access         MomentAccess     @default(CHECKED_IN)
  framesPerGuest Int              @default(15)
  cameraOpen     Boolean          @default(true)
  moderation     Boolean          @default(false)
  visibility     MomentVisibility @default(ALL)
  download       MomentDownload   @default(OWN)
  /// Film look ids guests may use; empty means all of them.
  enabledLooks   String[]         @default([])
  defaultLook    String           @default("none")
  screenEnabled  Boolean          @default(true)
}

model PhotoFrameSetting {
  id               String  @id @default("main")
  enabled          Boolean @default(true)
  frameOverlayUrl  String
  frameName        String?
  allowGuestToggle Boolean @default(true)
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())
}
