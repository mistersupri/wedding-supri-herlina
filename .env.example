# Admin utama untuk CMS. Kata sandinya hanya bisa diubah di sini.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ganti_kata_sandi_ini"

# Kunci tanda tangan sesi admin. Wajib diganti dengan string acak panjang di produksi.
JWT_SECRET="ganti_dengan_string_acak"
JWT_REFRESH_SECRET="ganti_dengan_string_acak_lain"

# Opsional: menyalin pesan suara tamu menjadi teks dengan Gemini.
GEMINI_API_KEY=""

# Opsional
# PORT=3000
