# ---------------------------------------------------------------------------
# Lokal: `yarn dev:local` tidak butuh file ini sama sekali.
# Produksi (Docker Compose): salin ke .env lalu isi semua yang bertanda WAJIB.
# Buat nilai acak dengan: openssl rand -hex 32
# ---------------------------------------------------------------------------

# WAJIB (produksi). Admin utama untuk CMS; kata sandinya hanya bisa diubah di sini.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# WAJIB (produksi). Kunci tanda tangan sesi admin, dua nilai acak yang berbeda.
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# WAJIB (Docker Compose). Kata sandi PostgreSQL; pakai huruf dan angka saja
# karena ikut disusun ke dalam DATABASE_URL.
POSTGRES_PASSWORD=""
# POSTGRES_USER="undangan"
# POSTGRES_DB="undangan"

# Hanya untuk `yarn dev` / produksi tanpa Compose. Compose menyusunnya sendiri.
# DATABASE_URL="postgresql://user:password@localhost:5432/undangan"

# Opsional: menyalin pesan suara tamu menjadi teks dengan Gemini.
GEMINI_API_KEY=""

# Opsional (Docker Compose)
# APP_PORT=3000          # port di host
# APP_BIND=127.0.0.1     # 0.0.0.0 untuk membuka langsung tanpa reverse proxy
# TRUST_PROXY=1          # jumlah reverse proxy di depan aplikasi

# Opsional
# PORT=3000
# UPLOAD_DIR="./uploads"
